---
const { compact = false } = Astro.props;
---

<aside
  class:list={["decision", { compact }]}
  aria-label="Current experiment decision"
>
  <div>
    <span class="status">NO-GO</span>
    <span class="eyebrow">EXP-001 · Data feasibility</span>
  </div>
  <h2>
    Coverage is established.
    <br />
    Historical forecasting is on hold.
  </h2>
  <p>
    Geographic consistency and historical release-time feature values remain
    unverified. The data audit is complete; the forecasting comparison has not
    been run.
  </p>
  {!compact && (
    <a class="text-link" href="/experiments/exp001/#reopen-conditions">
      What would reopen the experiment <span aria-hidden="true">↗</span>
    </a>
  )}
</aside>
