  <a class="experiment-card" href="/experiments/exp001/">
    <div class="experiment-id">
      EXP-001 <span class="status">NO-GO</span>
    </div>
    <div>
      <h2>Listing attention & newly pending activity</h2>
      <p>
        Completed data audit · Conditional forecasting protocol · Not activated
      </p>
    </div>
    <span class="arrow" aria-hidden="true">
      ↗
    </span>
  </a>
</Layout>
