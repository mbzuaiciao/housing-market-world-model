---
import Layout from "../../layouts/Layout.astro";
import { documents, documentUrl, sourceUrl } from "../../lib/research";
---

<Layout title="Data & Methods" section="methods">
  <section class="page-heading">
    <p class="eyebrow">Data & Methods</p>
    <h1>Read the source.</h1>
    <p class="lead">
      The repository Markdown, rendered directly. Follow the evidence from
      source definitions to the feasibility decision and the conditional plan.
    </p>
  </section>
  <div class="document-list">
    {documents.map((doc, index) => (
      <article class="panel document-card">
        <span class="eyebrow">0{index + 1} / Repository document</span>
        <h2>
          <a href={documentUrl(doc)}>
            {doc.title} <span aria-hidden="true">↗</span>
          </a>
        </h2>
        <p>{doc.description}</p>
        <code>{doc.path}</code>
        <a class="text-link" href={sourceUrl(doc)}>
          View Markdown on GitHub ↗
        </a>
      </article>
    ))}
  </div>
  <section class="section-space panel">
    <p class="eyebrow">Data-source attribution</p>
    <h2>Published research, with provenance.</h2>
    <ul class="attributions">
      <li>
        Attention data:{" "}
        <a href="https://www.realtor.com/research/data/">
          Realtor.com® Economic Research
        </a>
        .
      </li>
      <li>
        Data Provided by Zillow Group via{" "}
        <a href="https://www.zillow.com/research/data/">Zillow Research</a>.
      </li>
      <li>
        Mortgage rates: Freddie Mac’s Primary Mortgage Market Survey®,{" "}
        <a href="https://fred.stlouisfed.org/series/MORTGAGE30US">
          MORTGAGE30US via FRED, Federal Reserve Bank of St. Louis
        </a>
        .
      </li>
      <li>
        Metro delineations:{" "}
        <a href="https://www.census.gov/geographies/reference-files/time-series/demo/metro-micro/delineation-files.html">
          U.S. Census Bureau
        </a>
        , July 2023 OMB delineations.
      </li>
    </ul>
    <p>
      The dashboard contains derived coverage counts and report text. Publisher
      downloads remain outside the repository. See the audit for definitions,
      use guidance and recorded hashes.
    </p>
  </section>
</Layout>
